{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start",
      "startServerReadyPattern": "Ready",
      "startServerReadyTimeout": 60000,
      "numberOfRuns": 5,
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/shortlist?cgpa=2.5&scale=cgpa_4&field=cs&countries=DE,UK,CA,US",
        "http://localhost:3000/program/tum-msc-informatics",
        "http://localhost:3000/citizenship",
        "http://localhost:3000/plan-b?cgpa=2.5&scale=cgpa_4&field=cs",
        "http://localhost:3000/check"
      ],
      "settings": {
        "chromeFlags": "--no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 300 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
