# Copy to .env.local and fill in. NEVER commit real values.
# The app runs WITHOUT any of these (seed JSON data, deterministic chat fallback).

# --- Supabase (Postgres + Auth + RLS) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the seed script, the hard-delete-account route and /api/report inserts. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Set to "seed" to force the bundled JSON even when Supabase is configured.
DATA_SOURCE=
# Optional. Salt for hashing client IPs in rate limiters (any random string).
REPORT_IP_SALT=

# --- AI chat provider (server-side only). xAI Grok is used when XAI_API_KEY is set; otherwise Anthropic. ---
# xAI (Grok): key from console.x.ai
XAI_API_KEY=
# Default: grok-4
XAI_MODEL=
# --- Anthropic (server-side only) ---
ANTHROPIC_API_KEY=
# Default: claude-opus-5-5
ANTHROPIC_MODEL=
# Per-user daily output-token budget for chat (default 20000)
CHAT_DAILY_TOKEN_BUDGET=
# Global daily output-token cap across all users (default 500000). Chat falls back to the no-AI answer when reached.
CHAT_GLOBAL_DAILY_TOKEN_CAP=

# --- Cloudflare Turnstile (optional) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Demo ---
# Pin "now" (ISO date) so confidence ages are stable during a recorded demo.
MASTERSPATH_NOW=

# --- Project links (optional) ---
# https://github.com/<owner>/<repo>; enables the GitHub issues link on /privacy and /disclaimer
NEXT_PUBLIC_REPO_URL=

# --- Self-hosting (optional) ---
# Set to 1 at BUILD time when self-hosting behind HTTPS (not needed on Vercel, which is detected automatically).
# Leave unset for the plain-HTTP laptop demo, otherwise browsers refuse to load CSS/JS over http.
CSP_UPGRADE_INSECURE=
